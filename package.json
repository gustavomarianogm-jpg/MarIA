{
  "name": "maria-main",
  "version": "1.0.0",
  "description": "> A 1ª Assessora de Imprensa Virtual do Brasil 🇧🇷",
  "main": "index.js",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.4"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "vercel-build": "npm --prefix backend install && npm --prefix frontend install && cd backend && npx tsc && cd .. && npm --prefix frontend run build",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavomarianogm-jpg/MarIA.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/gustavomarianogm-jpg/MarIA/issues"
  },
  "homepage": "https://github.com/gustavomarianogm-jpg/MarIA#readme",
  "engines": {
    "node": "20.x"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
