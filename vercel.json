{
    "headers": [
          {
                  "source": "/(.*)",
                  "headers": [
                            {
                                        "key": "Content-Type",
                                        "value": "text/html; charset=utf-8"
                            }
                  ]
          },
          {
                  "source": "/api/(.*)",
                  "headers": [
                            {
                                        "key": "Content-Type",
                                        "value": "application/json; charset=utf-8"
                            }
                  ]
          }
    ]
}
